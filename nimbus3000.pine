//@version=6
// Nimbus3000 – daytrading-strategi för timgrafen (1H). Samma regler som backtestmotorn nimbus/engine.mjs.
//  Regim  : Trendlinjen på dagsgrafen (senaste stängda dag). Bull = bara köp, bear = bara blankning.
//  Modul A: volatilitetsutbrott (Crabel/Williams) – stängning > dagens öppning + k × dags-ATR, över VWAP, hög volym.
//  Modul B: rekyl i trend (Raschke/Connors) – RSI(2) < 10 i upptrend (EMA20 > EMA50), ut vid stängning över EMA20.
//  Risk   : 1 % av kapitalet per affär, stopp 2 × ATR, break-even vid +1R, släpande stopp, max 3 affärer
//           och max −2 % per dag. Aktier stängs vid dagens sista stapel.
// Ställ in avgift under Inställningar → Egenskaper: 0,40 % för Kraken (taker), cirka 0,05 % för aktier.
strategy("Nimbus3000", overlay = true, initial_capital = 10000, pyramiding = 0,
     commission_type = strategy.commission.percent, commission_value = 0.40, slippage = 0,
     calc_on_every_tick = false, process_orders_on_close = false)

// ---------------- Inställningar ----------------
g1 = "Risk"
riskPct   = input.float(1.0, "Risk per affär (% av kapital)", minval = 0.1, step = 0.1, group = g1)
maxTrades = input.int(3, "Max affärer per dag", minval = 1, group = g1)
dayLoss   = input.float(2.0, "Sluta handla för dagen vid förlust (%)", minval = 0.1, step = 0.5, group = g1)
allowShort = input.bool(true, "Tillåt blankning", group = g1)
g2 = "Modul A – utbrott"
useA     = input.bool(true, "Använd modul A", group = g2)
bkK      = input.float(0.5, "Utbrott: k × dags-ATR från dagens öppning", step = 0.05, group = g2)
volMult  = input.float(1.2, "Volym över snitt (×)", step = 0.1, group = g2)
bkStop   = input.float(2.0, "Stopp (× tim-ATR)", step = 0.1, group = g2)
bkBeR    = input.float(1.0, "Flytta stopp till break-even vid (R)", step = 0.1, group = g2)
bkTrail  = input.float(2.5, "Släpande stopp (× tim-ATR)", step = 0.1, group = g2)
g3 = "Modul B – rekyl"
useB     = input.bool(true, "Använd modul B", group = g3)
pbRsi    = input.float(10, "RSI(2) under (köp) / över 100 − värdet (blankning)", group = g3)
pbStop   = input.float(2.0, "Stopp (× tim-ATR)", step = 0.1, group = g3)
pbMax    = input.int(12, "Max staplar i affären", group = g3)
g4 = "Övrigt"
cryptoMax = input.int(24, "Krypto: max staplar per affär", group = g4)
tAtr      = input.int(10, "Trendlinjen ATR-längd", group = g4)
tMult     = input.float(3.2, "Trendlinjen multiplikator", step = 0.1, group = g4)
showPanel = input.bool(true, "Visa panel", group = g4)

// ---------------- Dagsregim (Trendlinjen, stängd dag, ingen repaint) ----------------
f_dir() =>
    atr = ta.rma(ta.tr(true), tAtr)
    src = hl2
    up  = src - tMult * atr
    dn  = src + tMult * atr
    var float upT = na
    var float dnT = na
    var int dir = 1
    upPrev = nz(upT, up)
    dnPrev = nz(dnT, dn)
    upT := close[1] > upPrev ? math.max(up, upPrev) : up
    dnT := close[1] < dnPrev ? math.min(dn, dnPrev) : dn
    if dir == -1 and close > dnPrev
        dir := 1
    else if dir == 1 and close < upPrev
        dir := -1
    [dir, ta.rma(ta.tr(true), 14)]

// Värdet för föregående (stängda) dag
f_dirPrev() =>
    [d, a] = f_dir()
    [d[1], a[1]]

[dDir, dAtr] = request.security(syminfo.tickerid, "D", f_dirPrev(), lookahead = barmerge.lookahead_on)

// ---------------- Timindikatorer ----------------
isCrypto = syminfo.type == "crypto"
newDay   = timeframe.change("D")
ema20    = ta.ema(close, 20)
ema50    = ta.ema(close, 50)
atrH     = ta.rma(ta.tr(true), 14)
rsi2     = ta.rsi(close, 2)
volSma   = ta.sma(volume, 20)
vwapV    = ta.vwap(hlc3)
var float sessOpen = na
if newDay
    sessOpen := open
lastBar  = not isCrypto and session.islastbar_regular

// ---------------- Dagsgränser ----------------
var int   nToday   = 0
var float dayStart = strategy.initial_capital
var bool  bkLong   = false
var bool  bkShort  = false
if newDay
    nToday   := 0
    dayStart := strategy.equity
    bkLong   := false
    bkShort  := false
dayOk = nToday < maxTrades and strategy.equity > dayStart * (1 - dayLoss / 100)

// ---------------- Positionshantering ----------------
var float stopLvl = na
var float riskDist = na
var float extreme = na
var bool  beDone = false
var string mod = ""
inPos = strategy.position_size != 0
side  = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
held  = inPos ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
entryPx = inPos ? strategy.position_avg_price : na

// Initiera stoppet på första stapeln i affären (utgår från faktiskt ingångspris)
if inPos and not inPos[1]
    stopLvl := entryPx - side * riskDist
    extreme := entryPx
    beDone  := false

if inPos
    closedNow = false
    if mod == "B" and (side == 1 ? close > ema20 : close < ema20)
        strategy.close_all(comment = "Mål EMA20", immediately = true)
        closedNow := true
    else if lastBar
        strategy.close_all(comment = "Dagens slut", immediately = true)
        closedNow := true
    else if mod == "B" and held >= pbMax
        strategy.close_all(comment = "Tid", immediately = true)
        closedNow := true
    else if isCrypto and held >= cryptoMax
        strategy.close_all(comment = "Tid", immediately = true)
        closedNow := true
    if not closedNow and mod == "A"
        extreme := side == 1 ? math.max(extreme, high) : math.min(extreme, low)
        if not beDone and (extreme - entryPx) * side >= bkBeR * riskDist
            beDone  := true
            stopLvl := side == 1 ? math.max(stopLvl, entryPx) : math.min(stopLvl, entryPx)
        if beDone
            tr = extreme - side * bkTrail * atrH
            stopLvl := side == 1 ? math.max(stopLvl, tr) : math.min(stopLvl, tr)
    if not closedNow
        strategy.exit("Stopp", stop = stopLvl, comment = beDone ? "Släpande stopp" : "Stopp")

// ---------------- Signaler (fylls på nästa stapels öppning) ----------------
reg = dDir
canTrade = not inPos and not lastBar and dayOk and not na(reg) and not na(dAtr) and not na(ema50) and not na(atrH)
thrL = sessOpen + bkK * dAtr
thrS = sessOpen - bkK * dAtr
volOk = na(volSma) or volSma == 0 or volume > volMult * volSma
bkL = useA and not bkLong  and close > thrL and (newDay or close[1] <= thrL) and close > vwapV and volOk
bkS = useA and not bkShort and close < thrS and (newDay or close[1] >= thrS) and close < vwapV and volOk
pbL = useB and close > ema50 and ema20 > ema50 and rsi2 < pbRsi
pbS = useB and close < ema50 and ema20 < ema50 and rsi2 > 100 - pbRsi

f_qty(dist) =>
    math.max(0, math.min(strategy.equity * riskPct / 100 / dist, strategy.equity / close))

goL = canTrade and reg == 1 and (bkL or pbL)
goS = canTrade and reg == -1 and allowShort and (bkS or pbS)
if goL
    mod      := bkL ? "A" : "B"
    riskDist := (mod == "A" ? bkStop : pbStop) * atrH
    bkLong   := bkLong or mod == "A"
    nToday   += 1
    strategy.entry("Köp", strategy.long, qty = f_qty(riskDist), comment = mod == "A" ? "Utbrott" : "Rekyl",
         alert_message = '{"bot":"nimbus3000","action":"buy","symbol":"' + syminfo.ticker + '","stop":' + str.tostring(close - riskDist) + '}')
if goS
    mod      := bkS ? "A" : "B"
    riskDist := (mod == "A" ? bkStop : pbStop) * atrH
    bkShort  := bkShort or mod == "A"
    nToday   += 1
    strategy.entry("Blanka", strategy.short, qty = f_qty(riskDist), comment = mod == "A" ? "Utbrott" : "Rekyl",
         alert_message = '{"bot":"nimbus3000","action":"sell","symbol":"' + syminfo.ticker + '","stop":' + str.tostring(close + riskDist) + '}')

// ---------------- Ritning ----------------
regCol = reg == 1 ? color.new(#00c176, 92) : reg == -1 ? color.new(#ff3b5c, 92) : na
bgcolor(regCol, title = "Dagsregim")
plot(ema20, "EMA20", color.new(color.orange, 30))
plot(ema50, "EMA50", color.new(color.blue, 30))
plot(vwapV, "VWAP", color.new(color.purple, 20), style = plot.style_circles, linewidth = 1)
plot(reg == 1 ? thrL : na, "Utbrottsnivå köp", color.new(#00c176, 0), style = plot.style_linebr)
plot(reg == -1 ? thrS : na, "Utbrottsnivå blankning", color.new(#ff3b5c, 0), style = plot.style_linebr)
plot(inPos ? stopLvl : na, "Stopp", color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)

var table pnl = table.new(position.top_right, 2, 6, border_width = 1, border_color = color.new(color.gray, 70))
if showPanel and barstate.islast
    bg = color.new(color.black, 10)
    table.cell(pnl, 0, 0, "Nimbus3000", text_color = color.white, bgcolor = bg)
    table.cell(pnl, 1, 0, reg == 1 ? "BULL-REGIM" : "BEAR-REGIM", text_color = color.white, bgcolor = reg == 1 ? #00c176 : #ff3b5c)
    table.cell(pnl, 0, 1, "Affärer idag", text_color = color.white, bgcolor = bg)
    table.cell(pnl, 1, 1, str.tostring(nToday) + " / " + str.tostring(maxTrades), text_color = color.silver, bgcolor = bg)
    table.cell(pnl, 0, 2, "Position", text_color = color.white, bgcolor = bg)
    table.cell(pnl, 1, 2, side == 1 ? "Lång (" + mod + ")" : side == -1 ? "Kort (" + mod + ")" : "Ingen", text_color = color.silver, bgcolor = bg)
    table.cell(pnl, 0, 3, "Resultat totalt", text_color = color.white, bgcolor = bg)
    table.cell(pnl, 1, 3, str.tostring(strategy.netprofit / strategy.initial_capital * 100, "#.#") + " %", text_color = strategy.netprofit >= 0 ? #00c176 : #ff3b5c, bgcolor = bg)
    table.cell(pnl, 0, 4, "Affärer / vinst-%", text_color = color.white, bgcolor = bg)
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(pnl, 1, 4, str.tostring(strategy.closedtrades) + " / " + str.tostring(wr, "#") + " %", text_color = color.silver, bgcolor = bg)
    table.cell(pnl, 0, 5, "Max nedgång", text_color = color.white, bgcolor = bg)
    table.cell(pnl, 1, 5, str.tostring(strategy.max_drawdown_percent, "#.#") + " %", text_color = color.silver, bgcolor = bg)
